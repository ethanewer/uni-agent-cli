#!/bin/sh

skip_prepaint=0
agent=codex
for arg do
	case "$arg" in
		--help|-h|--list)
			skip_prepaint=1
			break
			;;
		-*)
			;;
		*)
			agent=$arg
			break
			;;
	esac
done

if [ "${TERM_PROGRAM:-}" = "vscode" ] || [ -n "${VSCODE_PID:-}" ] || [ -n "${VSCODE_INJECTION:-}" ]; then
	skip_prepaint=1
fi

json_path_value() {
	file=$1
	path_name=$2
	if [ -r "$file" ]; then
		awk -v want="$path_name" '
			BEGIN { depth = 0; in_string = 0; esc = 0; expect_value = 0; last_key = ""; mode = ""; path[0] = "" }
			{
				for (i = 1; i <= length($0); i++) {
					c = substr($0, i, 1)
					if (in_string) {
						if (esc) {
							esc = 0
							if (collecting) token = token c
							continue
						}
						if (c == "\\") {
							esc = 1
							if (collecting) token = token c
							continue
						}
						if (c == "\"") {
							in_string = 0
							if (collecting && mode == "key") {
								last_key = token
							} else if (collecting && mode == "value" && current_path(last_key) == want) {
								print token
								exit
							}
							collecting = 0
							mode = ""
							continue
						}
						if (collecting) token = token c
						continue
					}
					if (c == "{") {
						if (expect_value && last_key != "") path[depth + 1] = current_path(last_key)
						else if (depth == 0) path[1] = ""
						depth++
						expect_value = 0
					} else if (c == "}") {
						delete path[depth]
						depth--
						expect_value = 0
						last_key = ""
					} else if (depth >= 1 && c == ":") expect_value = 1
					else if (depth >= 1 && c == ",") {
						expect_value = 0
						last_key = ""
					} else if (c == "\"" && depth >= 1) {
						in_string = 1
						token = ""
						mode = expect_value ? "value" : "key"
						collecting = 1
					} else if (depth >= 1 && expect_value && c !~ /[[:space:]]/) {
						expect_value = 0
						last_key = ""
					}
				}
			}
			function current_path(extra, base) {
				base = path[depth]
				if (extra == "") return base
				return base == "" ? extra : base "." extra
			}
		' "$file"
	fi
}

normalize_theme() {
	value=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr ' _' '--')
	case "$value" in
		onedark) value=one-dark ;;
		catppuccinmacchiato) value=catppuccin-macchiato ;;
		tokyo|tokyo-night) value=tokyonight ;;
	esac
	case "$value" in
		system|opencode|tokyonight|everforest|ayu|catppuccin|catppuccin-macchiato|gruvbox|kanagawa|nord|matrix|one-dark|dracula|monokai)
			printf '%s' "$value"
			;;
		*)
			printf 'system'
			;;
	esac
}

theme_from_settings() {
	config_file=${CC_CONFIG:-"$HOME/.config/cc/config.json"}
	settings_file=${CC_SETTINGS:-"$HOME/.config/cc/settings.json"}
	theme=$(json_path_value "$config_file" theme)
	config_settings_theme=$(json_path_value "$config_file" settings.theme)
	if [ -n "$config_settings_theme" ]; then
		theme=$config_settings_theme
	fi
	settings_theme=$(json_path_value "$settings_file" theme)
	if [ -n "$settings_theme" ]; then
		theme=$settings_theme
	fi
	normalize_theme "${theme:-system}"
}

apply_theme_colors() {
	esc=$(printf '\033')
	case "$1" in
		opencode) primary="${esc}[38;2;125;211;252m"; accent="${esc}[38;2;52;211;153m"; muted="${esc}[38;2;148;163;184m"; muted_close="${esc}[39m" ;;
		tokyonight) primary="${esc}[38;2;122;162;247m"; accent="${esc}[38;2;125;207;255m"; muted="${esc}[38;2;86;95;137m"; muted_close="${esc}[39m" ;;
		everforest) primary="${esc}[38;2;167;192;128m"; accent="${esc}[38;2;131;192;146m"; muted="${esc}[38;2;133;146;137m"; muted_close="${esc}[39m" ;;
		ayu) primary="${esc}[38;2;89;194;255m"; accent="${esc}[38;2;149;230;203m"; muted="${esc}[38;2;98;106;115m"; muted_close="${esc}[39m" ;;
		catppuccin) primary="${esc}[38;2;137;180;250m"; accent="${esc}[38;2;148;226;213m"; muted="${esc}[38;2;127;132;156m"; muted_close="${esc}[39m" ;;
		catppuccin-macchiato) primary="${esc}[38;2;138;173;244m"; accent="${esc}[38;2;139;213;202m"; muted="${esc}[38;2;128;135;162m"; muted_close="${esc}[39m" ;;
		gruvbox) primary="${esc}[38;2;131;165;152m"; accent="${esc}[38;2;142;192;124m"; muted="${esc}[38;2;146;131;116m"; muted_close="${esc}[39m" ;;
		kanagawa) primary="${esc}[38;2;126;156;216m"; accent="${esc}[38;2;122;168;159m"; muted="${esc}[38;2;114;113;105m"; muted_close="${esc}[39m" ;;
		nord) primary="${esc}[38;2;136;192;208m"; accent="${esc}[38;2;143;188;187m"; muted="${esc}[38;2;129;161;193m"; muted_close="${esc}[39m" ;;
		matrix) primary="${esc}[38;2;0;255;65m"; accent="${esc}[38;2;0;204;51m"; muted="${esc}[38;2;79;143;92m"; muted_close="${esc}[39m" ;;
		one-dark) primary="${esc}[38;2;97;175;239m"; accent="${esc}[38;2;86;182;194m"; muted="${esc}[38;2;92;99;112m"; muted_close="${esc}[39m" ;;
		dracula) primary="${esc}[38;2;139;233;253m"; accent="${esc}[38;2;80;250;123m"; muted="${esc}[38;2;98;114;164m"; muted_close="${esc}[39m" ;;
		monokai) primary="${esc}[38;2;102;217;239m"; accent="${esc}[38;2;166;226;46m"; muted="${esc}[38;2;117;113;94m"; muted_close="${esc}[39m" ;;
		*) primary="${esc}[34m"; accent="${esc}[36m"; muted="${esc}[2m"; muted_close="${esc}[22m" ;;
	esac
	reset="${esc}[39m"
}

if [ "$skip_prepaint" -eq 0 ] && [ -t 1 ]; then
	width=${COLUMNS:-80}
	case "$width" in
		''|*[!0-9]*)
			width=80
			;;
	esac
	size=$(stty size 2>/dev/null)
	case "$size" in
		*" "*)
			width=${size#* }
			;;
	esac
	theme=$(theme_from_settings)
	apply_theme_colors "$theme"
	rule=$(printf '%*s' "$width" '' | tr ' ' '─')
	cwd=${PWD:-}
	case "$cwd" in
		"$HOME"*)
			cwd="~${cwd#"$HOME"}"
			;;
	esac
	printf '\0337\033[?2026h%s%s%s\n%s○%s   %sSpace to record · Ctrl+Space for text%s\n%s%s%s\n%s%s acp · %s%s\033[?2026l\033[?25l' "$primary" "$rule" "$reset" "$accent" "$reset" "$muted" "$muted_close" "$primary" "$rule" "$reset" "$muted" "$agent" "$cwd" "$muted_close"
	export CC_PREPAINTED=1
	export CC_PREPAINT_AGENT=$agent
	export CC_PREPAINT_THEME=$theme
fi

script=$0
while [ -L "$script" ]; do
	link=$(readlink "$script") || exit 1
	case "$link" in
		/*)
			script=$link
			;;
		*)
			script=$(dirname "$script")/$link
			;;
	esac
done

exec node "$(dirname "$script")/cc.mjs" "$@"
