#!/bin/sh

skip_prepaint=0
agent=codex
for arg do
	case "$arg" in
		--help|-h|--list)
			skip_prepaint=1
			break
			;;
		-*)
			;;
		*)
			agent=$arg
			break
			;;
	esac
done

if [ "${TERM_PROGRAM:-}" = "vscode" ] || [ -n "${VSCODE_PID:-}" ] || [ -n "${VSCODE_INJECTION:-}" ]; then
	skip_prepaint=1
fi

json_path_value() {
	file=$1
	path_name=$2
	if [ -r "$file" ]; then
		awk -v want="$path_name" '
			BEGIN { depth = 0; in_string = 0; esc = 0; expect_value = 0; last_key = ""; mode = ""; path[0] = "" }
			{
				for (i = 1; i <= length($0); i++) {
					c = substr($0, i, 1)
					if (in_string) {
						if (esc) {
							esc = 0
							if (collecting) token = token c
							continue
						}
						if (c == "\\") {
							esc = 1
							if (collecting) token = token c
							continue
						}
						if (c == "\"") {
							in_string = 0
							if (collecting && mode == "key") {
								last_key = token
							} else if (collecting && mode == "value" && current_path(last_key) == want) {
								print token
								exit
							}
							collecting = 0
							mode = ""
							continue
						}
						if (collecting) token = token c
						continue
					}
					if (c == "{") {
						if (expect_value && last_key != "") path[depth + 1] = current_path(last_key)
						else if (depth == 0) path[1] = ""
						depth++
						expect_value = 0
					} else if (c == "}") {
						delete path[depth]
						depth--
						expect_value = 0
						last_key = ""
					} else if (depth >= 1 && c == ":") expect_value = 1
					else if (depth >= 1 && c == ",") {
						expect_value = 0
						last_key = ""
					} else if (c == "\"" && depth >= 1) {
						in_string = 1
						token = ""
						mode = expect_value ? "value" : "key"
						collecting = 1
					} else if (depth >= 1 && expect_value && c !~ /[[:space:]]/) {
						expect_value = 0
						last_key = ""
					}
				}
			}
			function current_path(extra, base) {
				base = path[depth]
				if (extra == "") return base
				return base == "" ? extra : base "." extra
			}
		' "$file"
	fi
}

normalize_theme() {
	value=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr ' _' '--')
	case "$value" in
		onedark) value=one-dark ;;
		catppuccinmacchiato) value=catppuccin-macchiato ;;
		tokyo|tokyo-night) value=tokyonight ;;
		cursor|cursor-default) value=cursor-dark ;;
		cursor-dark-midnight|cursormidnight|cursor--dark--midnight) value=cursor-midnight ;;
		cursorlight|cursor-light) value=cursor-light ;;
		cursor-dark-high-contrast|cursorhighcontrast) value=cursor-high-contrast ;;
		vscode|code|vs-code|visual-studio-code|vs-code-dark-modern|visual-studio-code-dark-modern|dark-modern) value=vscode-dark-modern ;;
		vs-code-dark+|vs-code-dark-plus|visual-studio-code-dark+|visual-studio-code-dark-plus|dark+|dark-plus|darkplus) value=vscode-dark-plus ;;
		vs-code-light-modern|visual-studio-code-light-modern|light-modern) value=vscode-light-modern ;;
		vs-code-light+|vs-code-light-plus|visual-studio-code-light+|visual-studio-code-light-plus|light+|light-plus|lightplus) value=vscode-light-plus ;;
		vs-code-dark-2026|visual-studio-code-dark-2026|dark-2026) value=vscode-dark-2026 ;;
		vs-code-light-2026|visual-studio-code-light-2026|light-2026) value=vscode-light-2026 ;;
	esac
	case "$value" in
		system|opencode|cursor-dark|cursor-midnight|cursor-light|cursor-high-contrast|vscode-dark-modern|vscode-dark-plus|vscode-light-modern|vscode-light-plus|vscode-dark-2026|vscode-light-2026|tokyonight|everforest|ayu|catppuccin|catppuccin-macchiato|gruvbox|kanagawa|nord|matrix|one-dark|dracula|monokai)
			printf '%s' "$value"
			;;
		*)
			printf 'system'
			;;
	esac
}

theme_from_settings() {
	config_file=${CC_CONFIG:-"$HOME/.config/cc/config.json"}
	settings_file=${CC_SETTINGS:-"$HOME/.config/cc/settings.json"}
	theme=$(json_path_value "$config_file" theme)
	config_settings_theme=$(json_path_value "$config_file" settings.theme)
	if [ -n "$config_settings_theme" ]; then
		theme=$config_settings_theme
	fi
	settings_theme=$(json_path_value "$settings_file" theme)
	if [ -n "$settings_theme" ]; then
		theme=$settings_theme
	fi
	normalize_theme "${theme:-system}"
}

apply_theme_colors() {
	esc=$(printf '\033')
	case "$1" in
		opencode) primary="${esc}[38;2;125;211;252m"; accent="${esc}[38;2;52;211;153m"; muted="${esc}[38;2;148;163;184m"; muted_close="${esc}[39m" ;;
		cursor-dark) primary="${esc}[38;2;129;161;193m"; accent="${esc}[38;2;129;161;193m"; muted="${esc}[38;2;137;137;137m"; muted_close="${esc}[39m" ;;
		cursor-midnight) primary="${esc}[38;2;136;192;208m"; accent="${esc}[38;2;143;188;187m"; muted="${esc}[38;2;76;86;106m"; muted_close="${esc}[39m" ;;
		cursor-light) primary="${esc}[38;2;60;124;171m"; accent="${esc}[38;2;60;124;171m"; muted="${esc}[38;2;137;137;137m"; muted_close="${esc}[39m" ;;
		cursor-high-contrast) primary="${esc}[38;2;67;76;94m"; accent="${esc}[38;2;136;192;208m"; muted="${esc}[38;2;80;80;80m"; muted_close="${esc}[39m" ;;
		vscode-dark-modern) primary="${esc}[38;2;0;120;212m"; accent="${esc}[38;2;77;170;252m"; muted="${esc}[38;2;157;157;157m"; muted_close="${esc}[39m" ;;
		vscode-dark-plus) primary="${esc}[38;2;86;156;214m"; accent="${esc}[38;2;78;201;176m"; muted="${esc}[38;2;128;128;128m"; muted_close="${esc}[39m" ;;
		vscode-light-modern) primary="${esc}[38;2;0;95;184m"; accent="${esc}[38;2;38;127;153m"; muted="${esc}[38;2;110;118;129m"; muted_close="${esc}[39m" ;;
		vscode-light-plus) primary="${esc}[38;2;0;0;255m"; accent="${esc}[38;2;38;127;153m"; muted="${esc}[38;2;111;111;111m"; muted_close="${esc}[39m" ;;
		vscode-dark-2026) primary="${esc}[38;2;57;148;188m"; accent="${esc}[38;2;72;160;199m"; muted="${esc}[38;2;140;140;140m"; muted_close="${esc}[39m" ;;
		vscode-light-2026) primary="${esc}[38;2;0;105;204m"; accent="${esc}[38;2;10;48;105m"; muted="${esc}[38;2;96;96;96m"; muted_close="${esc}[39m" ;;
		tokyonight) primary="${esc}[38;2;122;162;247m"; accent="${esc}[38;2;125;207;255m"; muted="${esc}[38;2;86;95;137m"; muted_close="${esc}[39m" ;;
		everforest) primary="${esc}[38;2;167;192;128m"; accent="${esc}[38;2;131;192;146m"; muted="${esc}[38;2;133;146;137m"; muted_close="${esc}[39m" ;;
		ayu) primary="${esc}[38;2;89;194;255m"; accent="${esc}[38;2;149;230;203m"; muted="${esc}[38;2;98;106;115m"; muted_close="${esc}[39m" ;;
		catppuccin) primary="${esc}[38;2;137;180;250m"; accent="${esc}[38;2;148;226;213m"; muted="${esc}[38;2;127;132;156m"; muted_close="${esc}[39m" ;;
		catppuccin-macchiato) primary="${esc}[38;2;138;173;244m"; accent="${esc}[38;2;139;213;202m"; muted="${esc}[38;2;128;135;162m"; muted_close="${esc}[39m" ;;
		gruvbox) primary="${esc}[38;2;131;165;152m"; accent="${esc}[38;2;142;192;124m"; muted="${esc}[38;2;146;131;116m"; muted_close="${esc}[39m" ;;
		kanagawa) primary="${esc}[38;2;126;156;216m"; accent="${esc}[38;2;122;168;159m"; muted="${esc}[38;2;114;113;105m"; muted_close="${esc}[39m" ;;
		nord) primary="${esc}[38;2;136;192;208m"; accent="${esc}[38;2;143;188;187m"; muted="${esc}[38;2;129;161;193m"; muted_close="${esc}[39m" ;;
		matrix) primary="${esc}[38;2;0;255;65m"; accent="${esc}[38;2;0;204;51m"; muted="${esc}[38;2;79;143;92m"; muted_close="${esc}[39m" ;;
		one-dark) primary="${esc}[38;2;97;175;239m"; accent="${esc}[38;2;86;182;194m"; muted="${esc}[38;2;92;99;112m"; muted_close="${esc}[39m" ;;
		dracula) primary="${esc}[38;2;139;233;253m"; accent="${esc}[38;2;80;250;123m"; muted="${esc}[38;2;98;114;164m"; muted_close="${esc}[39m" ;;
		monokai) primary="${esc}[38;2;102;217;239m"; accent="${esc}[38;2;166;226;46m"; muted="${esc}[38;2;117;113;94m"; muted_close="${esc}[39m" ;;
		*) primary="${esc}[34m"; accent="${esc}[36m"; muted="${esc}[2m"; muted_close="${esc}[22m" ;;
	esac
	reset="${esc}[39m"
}

truncate_ellipsis_text() {
	text=$1
	max_width=$2
	if [ "$max_width" -le 0 ]; then
		return
	fi
	length=$(text_length "$text")
	if [ "$length" -le "$max_width" ]; then
		printf '%s' "$text"
	elif [ "$max_width" -le 3 ]; then
		printf '%*s' "$max_width" '' | tr ' ' '.'
	else
		printf '%s...' "$(text_prefix "$text" "$((max_width - 3))")"
	fi
}

truncate_visual_text() {
	text=$1
	max_width=$2
	length=$(text_length "$text")
	if [ "$length" -le "$max_width" ]; then
		printf '%s' "$text"
		return
	fi
	inner_width=$((max_width - 1))
	if [ "$inner_width" -lt 1 ]; then
		inner_width=1
	fi
	printf '%s~' "$(truncate_ellipsis_text "$text" "$inner_width")"
}

text_length() {
	if command -v perl >/dev/null 2>&1; then
		printf '%s' "$1" | perl -CS -Mutf8 -0777 -ne 'print length($_)'
	else
		printf '%s' "$1" | wc -m | tr -d '[:space:]'
	fi
}

text_prefix() {
	text=$1
	max_width=$2
	if command -v perl >/dev/null 2>&1; then
		printf '%s' "$text" | MAX_WIDTH=$max_width perl -CS -Mutf8 -0777 -ne 'print substr($_, 0, $ENV{MAX_WIDTH})'
	else
		printf '%s' "$text" | awk -v max="$max_width" '{ printf "%s", substr($0, 1, max) }'
	fi
}

if [ "$skip_prepaint" -eq 0 ] && [ -t 1 ]; then
	width=${COLUMNS:-80}
	case "$width" in
		''|*[!0-9]*)
			width=80
			;;
	esac
	size=$(stty size 2>/dev/null)
	case "$size" in
		*" "*)
			width=${size#* }
			;;
	esac
	theme=$(theme_from_settings)
	apply_theme_colors "$theme"
	rule=$(printf '%*s' "$width" '' | tr ' ' '─')
	cwd=${PWD:-}
	case "$cwd" in
		"$HOME"*)
			cwd="~${cwd#"$HOME"}"
			;;
	esac
	voice_prompt="○   Space to record · Ctrl+Space for text"
	voice_line=$(truncate_ellipsis_text "$voice_prompt" "$width")
	status_line=$(truncate_visual_text "$agent acp · $cwd" "$width")
	printf '\0337\033[?2026h%s%s%s\n' "$primary" "$rule" "$reset"
	if [ "$(text_length "$voice_prompt")" -gt "$width" ]; then
		case "$voice_line" in
			○*...)
				voice_body=${voice_line#○}
				voice_body=${voice_body%...}
				printf '%s○%s%s%s%s...\n' "$accent" "$reset" "$muted" "$voice_body" "$muted_close"
				;;
			*)
				printf '%s\n' "$voice_line"
				;;
		esac
	else
		printf '%s○%s%s%s%s\n' "$accent" "$reset" "$muted" "${voice_line#○}" "$muted_close"
	fi
	printf '%s%s%s\n%s%s%s\033[?2026l\033[?25l' "$primary" "$rule" "$reset" "$muted" "$status_line" "$muted_close"
	export CC_PREPAINTED=1
	export CC_PREPAINT_AGENT=$agent
	export CC_PREPAINT_THEME=$theme
fi

script=$0
while [ -L "$script" ]; do
	link=$(readlink "$script") || exit 1
	case "$link" in
		/*)
			script=$link
			;;
		*)
			script=$(dirname "$script")/$link
			;;
	esac
done

exec node "$(dirname "$script")/cc.mjs" "$@"
